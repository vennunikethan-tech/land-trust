# ==============================================================================
# Land Trust - Environment Configuration
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Satellite Base Map API Key (Optional / Configurable)
# If using an official provider that requires an API key (e.g. MapTiler, ArcGIS Developer token, Mapbox),
# specify the key below without quotes.
# By default, Esri World Imagery operates directly via standard OGC Leaflet tile service.
VITE_SATELLITE_MAP_API_KEY=your_api_key_here

# Satellite Provider selector (optional, defaults to 'esri')
# Supported values: 'esri' | 'maptiler'
VITE_SATELLITE_MAP_PROVIDER=esri
